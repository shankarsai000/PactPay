# 1. Z3 Cryptographic Signing Secret
PACTPAY_HMAC_SECRET=pactpay-z3-cryptographic-gate-secret-2026

# 2. Pool 1: Channel3 (21,000 Credits Pool)
CHANNEL3_API_KEY=your_channel3_api_key_here

# 3. Pool 2: KERNEL Cloud Browser ($55 Credits Pool)
KERNEL_API_KEY=your_kernel_api_key_here
KERNEL_API_BASE=https://api.onkernel.com

# 4. Pool 3: Elastic Cloud (44-Day Free Trial)
ELASTICSEARCH_URL=https://your-deployment.es.us-west1.gcp.elastic-cloud.com
ELASTIC_API_KEY=your_elastic_api_key_here

# 5. Pool 4: PayPal Developer Sandbox REST API v2
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
